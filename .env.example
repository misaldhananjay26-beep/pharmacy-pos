# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────────────
# Safe to expose (anon/publishable). Enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEVER expose. Server-only. Bypasses RLS. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection used by the APP at runtime. Should be a least-privileged
# login role (e.g. `app_rls`) that is subject to RLS — NOT the database owner.
DATABASE_URL=postgresql://app_rls:password@db.your-project-ref.supabase.co:5432/postgres

# ── Bootstrapping ────────────────────────────────────────────────────
# Privileged (database owner) connection string used ONLY by `npm run db:seed` to apply
# supabase/seed.sql. Never used by the running app.
SEED_DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# Email of the first admin created by the seed script. Change after first login.
SEED_ADMIN_EMAIL=admin@pharmacy.local

# ── Rate limiting (optional: Upstash Redis; falls back to in-memory in dev) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
